# 复制为项目根目录的 .env.security，并填写真实值。
# 文件必须保持 600 权限，禁止提交 Git、截图或粘贴到聊天中。

# 公网访问地址，用于后端 CORS 和安全 Cookie 的同源配置。
PUBLIC_ORIGIN=https://da-system-sc.scuccs.me

# 设置为 true 后，前端显示 Turnstile，注册流程要求邮箱验证码。
EMAIL_VERIFICATION_REQUIRED=true

# Cloudflare Turnstile：Site Key 可出现在前端，Secret Key 只能给后端。
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_TIMEOUT_SECONDS=5
TURNSTILE_PASS_EXPIRE_MINUTES=5

# QQ 邮箱示例。SMTP_PASSWORD 填“授权码”，不要填邮箱登录密码。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=新材料数据分析系统
SMTP_USE_SSL=true
SMTP_TIMEOUT_SECONDS=10
