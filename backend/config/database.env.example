# MySQL 连接配置模板
# 复制为 backend/config/database.env 后，再根据本机环境填写密码。

# 运行环境：production 时关闭开发示例数据接口
APP_ENV=development

# 数据集上传和解析安全限制
MAX_DATASET_FILE_SIZE_MB=100
MAX_MATRIX_ROWS=50000
MAX_MATRIX_COLUMNS=5000
MAX_MAT_VARIABLES=100
USER_STORAGE_QUOTA_MB=2048
DATASET_PARSE_TIMEOUT_SECONDS=30

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=soft_web
DB_USER=root
DB_PASSWORD=change_me
DB_CHARSET=utf8mb4

# SQLAlchemy 连接地址。程序会根据上面的 DB_* 配置生成实际连接地址，
# 此字段仅作为本地配置参考，修改密码时请同步更新。
DATABASE_URL=mysql+pymysql://root:change_me@127.0.0.1:3306/soft_web?charset=utf8mb4

# 连接池配置
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_ECHO_SQL=false

# 任务结果和后台执行器配置
RESULT_STORAGE_DIR=../storage/results
TASK_EXECUTOR_ENABLED=true
TASK_POLL_INTERVAL_SECONDS=1

# Cloudflare Turnstile 人机验证配置
# 本地不填写 TURNSTILE_SECRET_KEY 时，后端会跳过验证码校验。
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_TIMEOUT_SECONDS=5
TURNSTILE_PASS_EXPIRE_MINUTES=5

# 注册邮箱验证码配置
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_CODE_EXPIRE_MINUTES=10
EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=OMELET Lab
SMTP_USE_SSL=true
SMTP_TIMEOUT_SECONDS=10
